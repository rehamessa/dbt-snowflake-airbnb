		sourceColumn: Test Category

		annotation SummarizationSetBy = Automatic

	partition dbt_Run_Results = m
		mode: import
		source =
				let
				    Source = Json.Document(File.Contents("E:\dbt-snowflake-airbnb\PBI\dbt_artifacts\run_results.json")),
				    Results = Table.FromList(Source[results], Splitter.SplitByNothing(), {"r"}),
				    Expanded = Table.ExpandRecordColumn(Results, "r",
				        {"unique_id", "status", "execution_time", "thread_id", "timing", "failures"}),
				    WithExec = Table.AddColumn(Expanded, "exec",
				        each try List.Last(List.Select([timing], (t) => t[name] = "execute")) otherwise null),
				    Started = Table.AddColumn(WithExec, "Started At",
				        each try DateTimeZone.RemoveZone(DateTimeZone.FromText([exec][started_at])) otherwise null, type datetime),
				    Completed = Table.AddColumn(Started, "Completed At",
				        each try DateTimeZone.RemoveZone(DateTimeZone.FromText([exec][completed_at])) otherwise null, type datetime),
				    ResType = Table.AddColumn(Completed, "Resource Type",
				        each Text.Split([unique_id], "."){0}, type text),
				    NodeName = Table.AddColumn(ResType, "Node Name",
				    each let p = Text.Split([unique_id], ".")
				            in if p{0} = "unit_test" and List.Count(p) > 3 then p{3}
				            else if p{0} = "model" and List.Count(p) > 3 then p{2} & "_" & p{3}
				            else p{2}, type text),
				    Thread = Table.AddColumn(NodeName, "Thread",
				        each Text.BeforeDelimiter([thread_id], " "), type text),
				    TestCat = Table.AddColumn(Thread, "Test Category",
				        each let n = [Node Name] in
				            if [Resource Type] <> "test" then null
				            else if Text.StartsWith(n, "dbt_expectations") then "dbt_expectations"
				            else if Text.StartsWith(n, "unique_") then "unique"
				            else if Text.StartsWith(n, "not_null_") then "not_null"
				            else if Text.StartsWith(n, "accepted_values_") then "accepted_values"
				            else if Text.StartsWith(n, "relationships_") then "relationships"
				            else "custom", type text),
				    Final = Table.SelectColumns(TestCat,
				        {"unique_id", "Resource Type", "Node Name", "status", "execution_time",
				         "Thread", "Started At", "Completed At", "failures", "Test Category"}),
				    Typed = Table.TransformColumnTypes(Final,
				        {{"status", type text}, {"execution_time", type number}, {"failures", Int64.Type}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

