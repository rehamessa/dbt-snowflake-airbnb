table _Measures
	lineageTag: 7c791ee2-3dd1-4c2d-b59b-062eb656728c

	measure 'Total Reviews' = COUNTROWS(Fact_Reviews)
		formatString: #,0
		lineageTag: 753ff3b8-1c25-4a28-b18c-383a8bf93571

	measure 'Total Listings' = COUNTROWS(Dim_Listings)
		formatString: #,0
		lineageTag: 68629bb8-be7e-4551-b709-5f18f340ef9c

	measure 'Total Hosts' = COUNTROWS(Dim_Hosts)
		formatString: #,0
		lineageTag: 9c753291-b51e-4a3c-a274-738e85060400

	measure 'Avg Price' = AVERAGE(Dim_Listings[PRICE])
		formatString: \$#,0.0;(\$#,0.0);\$#,0.0
		lineageTag: 2d15fe2a-0c9c-4539-bd74-ebb26beb2efc

	measure 'Positive %' = DIVIDE(CALCULATE([Total Reviews], Fact_Reviews[REVIEW_SENTIMENT] = "positive"), [Total Reviews])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: b9815acb-b0b6-476e-a501-9368369a144f

	measure 'Negative %' = DIVIDE(CALCULATE([Total Reviews], Fact_Reviews[REVIEW_SENTIMENT] = "negative"), [Total Reviews])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a1253144-e968-4a1f-a4a1-84e73917d064

	measure 'Reviews YoY %' =
			
			VAR ReviewsThisYear = [Total Reviews]
			VAR ReviewsLastYear = CALCULATE([Total Reviews], SAMEPERIODLASTYEAR(DimDate[Date]))
			RETURN DIVIDE(ReviewsThisYear - ReviewsLastYear, ReviewsLastYear)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a746f001-c9b7-4806-816b-184bb2031101

	measure 'Superhost %' = DIVIDE(CALCULATE([Total Hosts], Dim_Hosts[HOST_STATUS] = "superhost"), [Total Hosts])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 51f99af5-4653-47ca-95d0-33109281d9a6

	measure 'Large Hosts Share of Listings' =
			
			DIVIDE(
			    CALCULATE(SUM(Dim_Hosts[TOTAL_LISTINGS]), Dim_Hosts[PORTFOLIO_SIZE] = "large_portfolio"),
			    SUM(Dim_Hosts[TOTAL_LISTINGS])
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 12289a44-b65a-4469-874c-d6221cfff200

	measure 'HTML Hero' =
			
			VAR _Listings  = FORMAT([Total Listings], "#,0")
			VAR _Hosts     = FORMAT([Total Hosts], "#,0")
			VAR _Reviews   = FORMAT([Total Reviews] / 1000, "#,0.0") & "K"
			VAR _Price     = FORMAT([Avg Price], "$#,0")
			
			VAR _EntireHomePct =
			    FORMAT(DIVIDE(CALCULATE(COUNTROWS(Dim_Listings), Dim_Listings[ROOM_TYPE] = "Entire home/apt"), COUNTROWS(Dim_Listings)), "0%")
			VAR _SingleHostPct =
			    FORMAT(DIVIDE(CALCULATE(COUNTROWS(Dim_Hosts), Dim_Hosts[PORTFOLIO_SIZE] = "single_listing"), COUNTROWS(Dim_Hosts)), "0%")
			VAR _PositivePct = FORMAT([Positive %], "0%")
			VAR _MedianPrice = FORMAT(MEDIAN(Dim_Listings[PRICE]), "$#,0")
			
			VAR _FirstYear = YEAR(MIN(Fact_Reviews[REVIEW_DATE]))
			VAR _LastYear  = MAXX(FILTER(VALUES(DimDate[Year]), CALCULATE([Total Reviews]) > 10), DimDate[Year])
			
			VAR _Card =
			    "<div style='flex:1;background:#FFFFFF;border-radius:12px;padding:14px 18px;border-top:4px solid #F2B632;box-shadow:0 2px 6px rgba(23,37,65,0.06);'>" &
			        "<div style='font-size:11px;letter-spacing:1.5px;color:#8A7F6E;text-transform:uppercase;'>{l}</div>" &
			        "<div style='font-size:32px;font-weight:600;color:#14617E;line-height:1.15;margin-top:2px;'>{v}</div>" &
			        "<div style='font-size:12px;color:#6B6255;margin-top:4px;'>{s}</div>" &
			    "</div>"
			
			RETURN
			"<div style='font-family:Segoe UI, sans-serif;background:linear-gradient(135deg,#FFF8EC 0%,#F7E7C6 100%);border:1px solid #E9D8B4;border-radius:16px;padding:20px 24px;height:100%;box-sizing:border-box;overflow:hidden;'>" &
			
			    "<div style='padding-left:72px;min-height:56px;'>" &
			        "<div style='font-size:26px;font-weight:600;color:#172541;line-height:1.2;'>Airbnb: Market &amp; Guest Experience</div>" &
			        "<div style='font-size:13px;color:#6B6255;margin-top:2px;'>" & _FirstYear & "–" & _LastYear & " · Snowflake → dbt (tested &amp; documented) → Power BI</div>" &
			    "</div>" &
			
			    "<div style='display:flex;gap:14px;margin-top:16px;'>" &
			        SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_Card, "{l}", "Listings"),          "{v}", _Listings), "{s}", _EntireHomePct & " are entire homes") &
			        SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_Card, "{l}", "Hosts"),             "{v}", _Hosts),    "{s}", _SingleHostPct & " own a single listing") &
			        SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_Card, "{l}", "Reviews"),           "{v}", _Reviews),  "{s}", _PositivePct & " positive") &
			        SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_Card, "{l}", "Avg nightly price"), "{v}", _Price),    "{s}", "Median " & _MedianPrice) &
			    "</div>" &
			
			"</div>"
		lineageTag: 1efe538d-459f-425c-966b-bc63698ba02e

	column Column
		formatString: 0
		lineageTag: 209c5db8-d55b-4e69-a768-c673bf4cdd72
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition _Measures = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 820f7aa486c4445183757317fb02fbd5

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

